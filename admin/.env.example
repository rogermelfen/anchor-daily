# ============================================
# Anchor Daily Admin Panel - Miljøvariabler
# ============================================
# Kopier denne filen til .env og fyll inn dine verdier.
#
# MERK: Service role-nøkkelen er IKKE lenger nødvendig her.
# Admin-panelet bruker kun anon key for autentisering.
# Alle data-operasjoner går gjennom admin-api Edge Function
# som holder service role-nøkkelen server-side.

# Supabase (kun anon key — trygt for nettleser)
VITE_SUPABASE_URL=https://DIN_PROSJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=DIN_ANON_KEY
