# ============================================
# Anchor Daily Mobile - Miljøvariabler
# ============================================
# Kopier denne filen til .env og fyll inn dine verdier.
# Disse leses av app.config.ts og injiseres via Constants.expoConfig.extra.
# For produksjonsbygg: bruk EAS Secrets i stedet.

# Supabase
SUPABASE_URL=https://DIN_PROSJEKT.supabase.co
SUPABASE_ANON_KEY=DIN_ANON_KEY

# RevenueCat
REVENUECAT_IOS_API_KEY=DIN_REVENUECAT_IOS_KEY
REVENUECAT_ANDROID_API_KEY=DIN_REVENUECAT_ANDROID_KEY

# Sentry (valgfritt, for feilsporing)
SENTRY_DSN=
SENTRY_ORG=din-sentry-organisasjon
SENTRY_PROJECT=anchor-daily

# EAS
EAS_PROJECT_ID=DIN_EAS_PROSJEKT_ID
